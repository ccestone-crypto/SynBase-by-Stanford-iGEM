# Copy this file to .env and fill in real values to enable outgoing email
# (forgot-password reset links). If left unset, reset links are just printed
# to the server console instead of emailed — fine for local testing, not for
# a real deployment other people will use.

# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, Resend's
# SMTP endpoint, your school's mail server, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SynBase <no-reply@yourdomain.com>"

# Optional: overrides the base URL used to build reset-password links.
# If unset, the server infers it from the incoming request.
APP_BASE_URL=

# Comma-separated emails that get admin access automatically when they sign
# up. Set this BEFORE anyone signs up on a fresh deploy — otherwise no one is
# an admin and no one can use the Admin dashboard's promote/revoke controls.
# Additional admins can be granted later from the Admin dashboard itself.
ADMIN_EMAILS=you@example.com
