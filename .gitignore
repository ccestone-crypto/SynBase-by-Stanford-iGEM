# Dependencies
node_modules/

# Secrets and environment config
.env

# Runtime data — accounts, progress, applications, admin config, session secret.
# This is real student data and a signing secret; it must never be committed.
# On your host, mount a persistent disk/volume over server/data so it survives
# redeploys instead of relying on git for it.
server/data/*
!server/data/.gitkeep
!server/data/progress/
server/data/progress/*
!server/data/progress/.gitkeep

# Uploaded speaker-series videos — large binaries, not source code.
# Mount a persistent disk/volume here too (see note above) so uploads survive redeploys.
assets/video/speakers/*
!assets/video/speakers/.gitkeep

# Module teaching videos (admin-provided locally, can be large)
assets/video/*.mp4

# Local Claude Code tool-permission cache (machine/session-specific, not shared config)
.claude/settings.local.json

# OS/editor cruft
.DS_Store
Thumbs.db

# Unrelated scratch apps living in this same folder — not part of SiBRP Academy
/journal/
/scrapbook/
/todo/
/shared/
