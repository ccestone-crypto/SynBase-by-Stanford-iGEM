{
  "hosting": {
    "target": "synbase-target",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "data.db",
      "notes/**",
      "journal/**",
      "scrapbook/**",
      "todo/**",
      "shared/**",
      "supabase/**"
    ],
    "redirects": [
      { "source": "/", "destination": "/home.html", "type": 302 }
    ]
  }
}
